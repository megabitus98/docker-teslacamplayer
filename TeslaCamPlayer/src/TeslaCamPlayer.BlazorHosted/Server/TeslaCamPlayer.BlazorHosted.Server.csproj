<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>warnings</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <RuntimeIdentifiers>win-x64;win-x86;linux-x64;linux-musl-x64;linux-arm;linux-musl-arm;linux-arm64;linux-musl-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <!--
        WINDOWS only for Windows targets; everything else (Linux incl. 32-bit ARM, macOS, and a plain
        `dotnet run` on a non-Windows box) takes the LINUX path, which resolves ffprobe from PATH.
        Keyed off the target rather than an RID whitelist so a new RID can't silently fall through to
        WINDOWS. The Dockerfiles pass /p:DefineConstants=DOCKER, which overrides this.
    -->
    <PropertyGroup>
        <IsWindowsTarget Condition=" '$(RuntimeIdentifier)' == '' ">$([MSBuild]::IsOSPlatform('Windows'))</IsWindowsTarget>
        <IsWindowsTarget Condition=" '$(RuntimeIdentifier)' != '' ">$(RuntimeIdentifier.StartsWith('win'))</IsWindowsTarget>
        <DefineConstants Condition=" '$(IsWindowsTarget)' == 'true' ">TRACE;WINDOWS</DefineConstants>
        <DefineConstants Condition=" '$(IsWindowsTarget)' != 'true' ">TRACE;LINUX</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
            <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.0" />
            <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
            <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
            <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
            <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.5" />
            <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
            <PackageReference Include="Serilog" Version="3.1.1" />
            <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
            <PackageReference Include="Google.Protobuf" Version="3.33.1" />
            <!--
                Ships protoc; build-time only, never flows to the published output.
                Do NOT downgrade: the linux_arm64 protoc segfaults on the response file MSBuild feeds it
                in every version through 33.5 (Grpc.Tools 2.81.1), which breaks the arm64 image build while
                leaving macOS builds green. 35.1 is the first that handles it. Generated output is
                byte-identical across 31.1/33.5/35.1, so this stays compatible with Google.Protobuf 3.33.1.
            -->
            <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="all" />
        </ItemGroup>

    <!--
        SeiMetadata.proto is the single source: protoc regenerates the C# into obj/ on every build, so
        there is no checked-in copy to drift out of sync. The .proto declares no package and no
        csharp_namespace, so the generated SeiMetadata lands in the global namespace the consumers expect.
    -->
    <ItemGroup>
        <Protobuf Include="Models\SeiMetadata.proto" GrpcServices="None" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Client\TeslaCamPlayer.BlazorHosted.Client.csproj" />
        <ProjectReference Include="..\Shared\TeslaCamPlayer.BlazorHosted.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="lib\" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="lib\ffprobe.exe" />
        <None Remove="lib\hud_renderer.py" />
        <Content Include="lib\ffprobe.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="lib\hud_renderer.py">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>


</Project>
